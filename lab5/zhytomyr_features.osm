  <node id="9474076780" version="2" timestamp="2023-03-03T20:40:24Z" lat="50.5896925" lon="27.6199196">
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="У цьому будинку з 1967 по 1997 рік проживав Юрій Іванович Ковальський (1.05.1938 - 9.06.1997) журналіст, поет. Залишив значний слід у літературному житті поліського краю і є автором десятків пісень та Гімну Новограда-Волинського"/>
    <tag k="material" v="granite"/>
    <tag k="memorial" v="plaque"/>
    <tag k="name" v="Ю. І. Ковальському"/>
    <tag k="name:uk" v="Ю. І. Ковальському"/>
  </node>
  <node id="9474076809" version="1" timestamp="2022-02-04T11:20:10Z" lat="50.5897817" lon="27.6194214">
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="Вічна слава патріотам нашої Батьківщини, які загинули смертю хоробрих&#xA;&#xA;В честь партизан і підпільників м. Новоград-Волинського по звірячому замучених фашистами в роки великої вітчизняної війни 1941-1945 рр."/>
    <tag k="material" v="granite"/>
    <tag k="memorial" v="war_memorial"/>
  </node>
  <node id="9474076810" version="2" timestamp="2023-03-03T20:40:24Z" lat="50.590174" lon="27.6203946">
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="Слава в віках радянським воїнам і народу переможцям над німецько-фашистськими загарбниками у Великій Вітчизняній війні 1941-1945 рр.&#xA;В честь 20-річчя перемоги від трудящих м. Новоград-Волинського."/>
    <tag k="material" v="granite"/>
    <tag k="memorial" v="obelisk"/>
    <tag k="name" v="В честь 20-річчя Перемоги"/>
    <tag k="name:uk" v="В честь 20-річчя Перемоги"/>
  </node>
