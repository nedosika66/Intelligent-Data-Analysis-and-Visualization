  <node id="9473485657" version="2" timestamp="2022-02-04T11:20:10Z" lat="50.5899417" lon="27.6192968">
    <tag k="historic" v="memorial"/>
    <tag k="inscription" v="Дітям Новоград-Волинщини - розвідникам, зв&apos;язковим, підривникам партизанських загонів та підпільних груп, які загинули в боротьбі з фашистськими загарбниками 1941-1945 рр&#xA;від вдячних земляків 2002 року"/>
    <tag k="material" v="granite"/>
    <tag k="memorial" v="war_memorial"/>
  </node>
