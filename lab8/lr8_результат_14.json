 "код_студента": {
  "tournament": "def tournament(F, k, rng):\n    idx = rng.integers(0, len(F), size=k)\n    return int(idx[np.argmin(F[idx])])\n",
  "ox": "def ox(p1, p2, i, j):\n    n = len(p1)\n    child = np.full(n, -1, dtype=np.asarray(p1).dtype)\n    child[i:j+1] = p1[i:j+1]\n    taken = set(p1[i:j+1].tolist())\n\n    order = [p2[(j + 1 + t) % n] for t in range(n)]\n    order = [g for g in order if g not in taken]\n\n    free = [(j + 1 + t) % n for t in range(n)]\n    free = [pos for pos in free if not (i <= pos <= j)]\n\n    for pos, g in zip(free, order):\n        child[pos] = g\n    return child\n",
  "choose_next": "def choose_next(cur, left, tau, eta, alpha, beta, rng):\n    left = np.asarray(left)\n    w = tau[cur, left] ** alpha * eta[cur, left] ** beta\n    return int(rng.choice(left, p=w / w.sum()))\n",
  "update_pheromone": "def update_pheromone(tau, tours, lens, rho):\n    new = (1 - rho) * tau\n    for tour, L in zip(tours, lens):\n        t = np.concatenate(([0], tour, [0]))\n        np.add.at(new, (t[:-1], t[1:]), 1.0 / L)\n    return new\n"
 },
